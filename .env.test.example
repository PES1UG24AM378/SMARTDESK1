# Settings used by the automated tests (offline, deterministic). Copy over .env.local while testing:
#   cp .env.test.example .env.local   (then set your DB urls) -> npm run db:reset -> npm run embed -> npm run build -> npm start -> npm run test:api
# The SAME embedding provider must be used by `npm run embed` and by the running server.
ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smartdesk
APP_DB_PASSWORD=AppUser_Pass_2026
DATABASE_URL=postgresql://smartdesk_app:AppUser_Pass_2026@localhost:5432/smartdesk
JWT_SECRET=test-secret-for-automated-tests-0123456789abcdef01234567
CRON_SECRET=test-cron-secret
EMBEDDING_PROVIDER=hash
SIM_HIGH=0.60
SIM_MID=0.30
LLM_ENABLED=true
GEMINI_MOCK=true
NEXT_PUBLIC_DEMO_HINTS=true
