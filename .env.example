# ---------- Database ----------
# Used by the web application. For the best security use the restricted role created by db/roles.sql
# (smartdesk_app). For a quick local start you may use the owner account instead.
DATABASE_URL=postgresql://smartdesk_app:CHANGE_ME_app_password@localhost:5432/smartdesk
# Used only by the scripts (db:reset, tests): owner or superuser, needed to create the pgvector extension.
ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smartdesk
# Password given to the restricted role when db:reset runs (8+ chars: letters, digits and _ . ! @ # % ^ * -).
APP_DB_PASSWORD=CHANGE_ME_app_password

# ---------- Security ----------
# Random string of at least 32 characters. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_to_a_long_random_string_of_32_chars_or_more
# Lets a scheduler call POST /api/admin/sla-scan with the header  x-cron-secret: <this value>
CRON_SECRET=CHANGE_ME_cron_secret

# ---------- Embeddings (search by meaning) ----------
# minilm = pre-trained all-MiniLM-L6-v2, runs locally (needs internet ONCE to download the model).
# hash   = offline lexical fallback for demos and tests without internet (not a semantic model).
EMBEDDING_PROVIDER=minilm
EMBEDDING_WARMUP=true
EMBED_TIMEOUT_MS=8000

# ---------- Decision thresholds (cosine similarity) ----------
# Starting values for MiniLM. Tune them with: npm run embed && npm run eval
SIM_HIGH=0.80
SIM_MID=0.45
VOTE_SHARE=0.5
SIM_CLUSTER=0.75

# ---------- Gemini (LLM explanations) ----------
LLM_ENABLED=true
# Create a key at https://aistudio.google.com/ . Keep it secret and NEVER prefix it with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Model names change often: copy the current one from the Gemini API model list in Google's docs.
GEMINI_MODEL=
GEMINI_TIMEOUT_MS=10000
EXPLAIN_PER_HOUR=10
# true = offline demo of the explanation step without calling Gemini (used by the automated tests)
GEMINI_MOCK=false

# ---------- Demo ----------
# Shows one-click demo account buttons on the login page. Set to false for any real deployment.
NEXT_PUBLIC_DEMO_HINTS=true
